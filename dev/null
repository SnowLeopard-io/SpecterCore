      const args = ctx.rawArgs.slice(0, 5).map((a) => `0x${(a >>> 0).toString(16)}`);
      console.error(`[api] ${ctx.module}!${ctx.proc}(${args.join(", ")}) -> 0x${(result.returnValue >>> 0).toString(16)}`);
    }
